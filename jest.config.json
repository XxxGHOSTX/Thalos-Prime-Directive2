{
    "testEnvironment": "node",
    "collectCoverageFrom": [
        "**/*.js",
        "!node_modules/**",
        "!coverage/**",
        "!**/*.test.js",
        "!**/__tests__/**",
        "!eslint.config.js",
        "!jest.config.json"
    ],
    "coveragePathIgnorePatterns": ["/node_modules/", "/coverage/", "\\.test\\.js$"]
}
