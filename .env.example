# Application Configuration
APP_ENV=development
APP_NAME=thalos-prime
APP_PORT=8080
APP_HOST=127.0.0.1

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=5000
ENABLE_HEALTH_CHECKS=true

# Security
ENABLE_CORS=true
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set a random token of at least 32 bytes via a secure local environment or secret manager.
# Never commit the real value to Git.
# THALOS_API_TOKEN=<random-secret-at-least-32-bytes>
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# Database (if needed)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=thalos
# DB_USER=thalos
# DB_PASSWORD=changeme

# Redis (if needed)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# External Services
# API_KEY=your-api-key-here
# API_SECRET=your-api-secret-here

# Feature Flags
ENABLE_DEBUG_MODE=false
ENABLE_EXPERIMENTAL_FEATURES=false

# For local browser UI development only, set this only together with APP_ENV=development.
# Never enable it for staging, production, CI deployments, or unknown environments.
# THALOS_AUTH_DISABLED=1
